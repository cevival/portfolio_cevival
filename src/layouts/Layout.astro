---
import '@fontsource-variable/funnel-display/wght.css';
import '@fontsource-variable/funnel-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Guillaume Desplan — Développeur Full-Stack',
  description = 'Portfolio de Guillaume Desplan, Développeur Full-Stack passionné par la création d\'applications web modernes.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Guillaume Desplan" />
    <meta name="theme-color" content="#f8f6ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0d1a" media="(prefers-color-scheme: dark)" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Theme init script (prevents flash) + .js flag for scroll reveals -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        const stored = localStorage.getItem('portfolio-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          root.classList.add('dark');
        }
      })();
    </script>
    <!-- Sans JavaScript, rien ne lance les apparitions au défilement : le contenu reste visible -->
    <noscript>
      <style is:inline>
        .curtain [style],
        .finale [style] {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
