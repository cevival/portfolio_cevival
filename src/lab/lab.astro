---
// Page de labo : la ville seule, pilotée par l'URL. Servie uniquement par
// `npm run dev` (route injectée dans astro.config.mjs), absente du site construit.
// `scripts/city-posters.mjs` s'en sert pour régénérer les images d'attente.
//   /lab?theme=light&p=0.3          progression de la visite
//   /lab?stop=4                     posé sur l'arrêt n° 4 (à partir de 0)
//   /lab?view=finale&p=0.5          plan final
//   /lab?focus=qualitrack&az=45&el=30&d=40&y=4   caméra libre autour d'une parcelle
//   /lab?fx=0.18&fy=0               cadrage
//   /lab?og=1&fx=0.2                carte de partage : le nom par-dessus la ville
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Labo — ville</title>
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
      }
      astro-dev-toolbar {
        display: none !important;
      }
      canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      .og {
        position: fixed;
        inset: 0;
        display: none;
        flex-direction: column;
        justify-content: center;
        padding: 0 72px;
        background: linear-gradient(90deg, #0f0d1a 0%, rgba(15, 13, 26, 0.86) 30%, rgba(15, 13, 26, 0) 60%);
        color: #f3f1fb;
        font-family: "Funnel Sans Variable", sans-serif;
      }
      .og[data-on] {
        display: flex;
      }
      .og h1 {
        margin: 0;
        font-family: "Funnel Display Variable", sans-serif;
        font-weight: 700;
        font-size: 92px;
        line-height: 0.94;
        letter-spacing: -0.035em;
      }
      .og p {
        margin: 26px 0 0;
        font-family: "Funnel Display Variable", sans-serif;
        font-weight: 600;
        font-size: 34px;
      }
      .og span {
        margin-top: 14px;
        max-width: 500px;
        font-size: 23px;
        line-height: 1.4;
        color: #a7a3c0;
      }
    </style>
  </head>
  <body>
    <canvas id="city"></canvas>
    <div class="og">
      <h1>Guillaume<br />Desplan</h1>
      <p>Développeur full-stack</p>
      <span>Chaque site que j'ai livré est un bâtiment de cette ville.</span>
    </div>
    <script>
      import "@fontsource-variable/funnel-display/wght.css";
      import "@fontsource-variable/funnel-sans/wght.css";
      import { createCity } from "../city";
      import { LOTS, STOP_IDS, tourConfig, type StopId } from "../city/layout";
      import { stopProgress } from "../city/tour";
      import { featured, more } from "../data/projects";

      const query = new URLSearchParams(location.search);
      const number = (key: string, fallback: number) =>
        query.has(key) ? Number(query.get(key)) : fallback;
      const theme = query.get("theme") === "light" ? "light" : "dark";
      document.body.style.background = theme === "light" ? "#f8f6ff" : "#0f0d1a";

      const projects = [...featured, ...more];
      const canvas = document.getElementById("city") as HTMLCanvasElement;
      const city = createCity({
        canvas,
        theme,
        lotLabel: "Prochain chantier\nVotre projet ?",
        stops: STOP_IDS.map((id) => {
          const project = projects.find((p) => p.slug === id);
          const [small, large] = project
            ? [project.shot.srcSet.split(" ")[0], project.shot.src]
            : [undefined, undefined];
          return {
            id,
            title: project?.title ?? id,
            domain: project?.domain,
            screen: small && large ? { small, large } : undefined,
          };
        }),
      });

      city.setFraming(number("fx", 0), number("fy", 0));

      const rad = (degrees: number) => (degrees * Math.PI) / 180;
      const focus = query.get("focus") as StopId | null;
      if (focus) {
        const lot = LOTS.find((l) => l.id === focus) ?? LOTS[0];
        city.setView({
          kind: "free",
          active: query.has("lit") ? LOTS.indexOf(lot) : -1,
          pose: {
            target: [lot.x + number("ox", 0), number("y", 3), lot.z + number("oz", 0)],
            azimuth: rad(number("az", 45)),
            elevation: rad(number("el", 32)),
            distance: number("d", 34),
          },
        });
      } else if (query.get("view") === "finale") {
        city.setView({ kind: "finale", progress: number("p", 0) });
      } else if (query.has("stop")) {
        city.setView({ kind: "journey", progress: stopProgress(number("stop", 0), tourConfig) });
      } else {
        city.setView({ kind: "journey", progress: number("p", 0) });
      }

      // ?flip=800 : bascule animée vers l'autre thème après 800 ms
      if (query.has("flip")) {
        setTimeout(() => city.setTheme(theme === "light" ? "dark" : "light", true), number("flip", 800));
      }

      if (query.has("og")) document.querySelector(".og")?.setAttribute("data-on", "");

      addEventListener("resize", () => city.resize());
      city.start();
      Object.assign(window, { city });
    </script>
  </body>
</html>
